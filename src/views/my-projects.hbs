<div class="container mt-3 mb-2">
  <div id="projectAlertBox" class="alert d-none text-center" role="alert"></div>
  <h1 class="text-center py-3">ADD MY PROJECT</h1>

  <div id="projectForm" class="row">
    <div class="col-md-6 offset-md-3">
      <div class="form-group pb-2">
        <label for="projectName">Project Name</label>
        <input type="text" class="form-control" id="projectName" required />
        <div class="invalid-feedback">Project name is required</div>
      </div>

      <div class="form-group pb-2">
        <label for="startDate">Start Date</label>
        <input type="date" class="form-control" id="startDate" required />
        <div class="invalid-feedback">Start date is required</div>
      </div>

      <div class="form-group pb-2">
        <label for="endDate">End Date</label>
        <input type="date" class="form-control" id="endDate" required />
        <div class="invalid-feedback">End date is required</div>
      </div>

      <div class="form-group pb-2">
        <label for="description">Description <i>(optional)</i></label>
        <textarea class="form-control" id="description" rows="3"></textarea>
        <div class="invalid-feedback">Description is required</div>
      </div>

      <div class="form-group pb-2">
        <label>Technologies</label>
        <div id="techGroup">
          <div class="form-check form-check-inline">
            <input
              class="form-check-input tech-checkbox"
              type="checkbox"
              id="checkVue"
              value='<i class="devicon-vuejs-plain colored" style="font-size: 1.5rem;"></i>'
            />
            <label class="form-check-label" for="checkVue">Vue</label>
          </div>
          <div class="form-check form-check-inline">
            <input
              class="form-check-input tech-checkbox"
              type="checkbox"
              id="checkAngular"
              value='<i class="devicon-angular-plain colored" style="font-size: 1.5rem;"></i>'
            />
            <label class="form-check-label" for="checkAngular">Angular</label>
          </div>

          <div class="form-check form-check-inline">
            <input
              class="form-check-input tech-checkbox"
              type="checkbox"
              id="checkReact"
              value='<i class="devicon-react-original colored" style="font-size: 1.5rem;"></i>'
            />
            <label class="form-check-label" for="checkReact">React</label>
          </div>

          <div class="form-check form-check-inline">
            <input
              class="form-check-input tech-checkbox"
              type="checkbox"
              id="checkJS"
              value='<i class="devicon-javascript-plain colored" style="font-size: 1.5rem;"></i>'
            />
            <label class="form-check-label" for="checkJS">JavaScript</label>
          </div>

          <div class="form-check form-check-inline">
            <input
              class="form-check-input tech-checkbox"
              type="checkbox"
              value='<i class="devicon-typescript-plain colored" style="font-size: 1.5rem;"></i>'
            />
            <label class="form-check-label">TypeScript</label>
          </div>
        </div>

        <div class="invalid-feedback d-block" id="techFeedback">Please select at
          least one technology</div>
      </div>

      <div class="form-group pb-2">
        <label for="uploadImage">Upload Image <i>(optional)</i></label>
        <input
          type="file"
          class="form-control"
          id="uploadImage"
          accept="image/*"
        />
        <div class="invalid-feedback">Project image is required</div>
        <img
          id="imagePreview"
          class="img-fluid rounded mt-2 d-none"
          alt="Preview"
          style="max-height: 200px; object-fit: cover;"
        />
      </div>

      <div class="text-end pb-4">
        <button type="button" class="btn btn-info" id="submitBtn">Save Project</button>
      </div>
    </div>
  </div>

  <h2 class="text-center mt-4">MY PROJECTS</h2>

  <div class="container my-5">
    <div class="row g-4" id="root">
      {{#if dbError}}
        <div class="col-12">
          <div class="alert alert-danger text-center">
            Failed to load projects from the database.
          </div>
        </div>
      {{/if}}

      {{#each projects}}
        <div class="col-md-6 col-lg-4">
          <div class="card h-100 border-0 shadow-sm">
            <img
              src="{{image}}"
              class="card-img-top"
              alt="{{name}}"
              style="height: 200px; object-fit: cover;"
            />
            <div class="card-body d-flex flex-column">
              <h5 class="card-title">{{name}}</h5>
              <p class="text-muted small mb-2">
                Start date: {{startDateFormatted}}<br />
                End date: {{endDateFormatted}}
              </p>
              <p class="card-text" style="height: 80px; overflow-y: auto;">
                {{description}}
              </p>
              <p class="small mb-3">Technologies: {{{join techIcons " "}}}</p>
              <div class="mt-auto">
                <a
                  href="/project-detail/{{id}}"
                  class="btn btn-primary w-100 mb-2"
                >Detail</a>
                <div class="d-flex gap-2">
                  <button
                    class="btn btn-secondary btn-sm btn-edit w-50"
                    data-id="{{id}}"
                    data-name="{{name}}"
                    data-start="{{startDateISO}}"
                    data-end="{{endDateISO}}"
                    data-description="{{description}}"
                    data-tech="{{techIconsCsv}}"
                    data-image="{{image}}"
                  >Edit</button>
                  <button
                    class="btn btn-danger btn-sm btn-delete w-50"
                    data-id="{{id}}"
                  >Delete</button>
                </div>
              </div>
            </div>
          </div>
        </div>
      {{else}}
        <div class="col-12">
          <p class="text-center text-muted mb-0">No projects yet.</p>
        </div>
      {{/each}}
    </div>
  </div>

  <div
    class="modal fade"
    id="editProjectModal"
    tabindex="-1"
    aria-labelledby="editProjectModalLabel"
    aria-hidden="true"
  >
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="editProjectModalLabel">Edit Project</h5>
          <button
            type="button"
            class="btn-close"
            data-bs-dismiss="modal"
            aria-label="Close"
          ></button>
        </div>
        <div class="modal-body">
          <input type="hidden" id="editProjectId" />

          <div class="form-group pb-2">
            <label for="editProjectName">Project Name</label>
            <input type="text" class="form-control" id="editProjectName" />
          </div>

          <div class="form-group pb-2">
            <label for="editStartDate">Start Date</label>
            <input type="date" class="form-control" id="editStartDate" />
          </div>

          <div class="form-group pb-2">
            <label for="editEndDate">End Date</label>
            <input type="date" class="form-control" id="editEndDate" />
          </div>

          <div class="form-group pb-2">
            <label for="editDescription">Description</label>
            <textarea class="form-control" id="editDescription" rows="3"></textarea>
          </div>

          <div class="form-group pb-2">
            <label>Technologies</label><br />

          <div class="form-check form-check-inline">
              <input
                class="form-check-input edit-tech-checkbox"
                type="checkbox"
                value='<i class="devicon-vuejs-plain colored" style="font-size: 1.5rem;"></i>'
                id="editVue"
              />
              <label class="form-check-label" for="editVue">Vue</label>
            </div>

            <div class="form-check form-check-inline">
              <input
                class="form-check-input edit-tech-checkbox"
                type="checkbox"
                value='<i class="devicon-angular-plain colored" style="font-size: 1.5rem;"></i>'
                id="editAngular"
              />
              <label class="form-check-label" for="editAngular">Angular</label>
            </div>

            <div class="form-check form-check-inline">
              <input
                class="form-check-input edit-tech-checkbox"
                type="checkbox"
                value='<i class="devicon-react-original colored" style="font-size: 1.5rem;"></i>'
                id="editReact"
              />
              <label class="form-check-label" for="editReact">React</label>
            </div>

            <div class="form-check form-check-inline">
              <input
                class="form-check-input edit-tech-checkbox"
                type="checkbox"
                value='<i class="devicon-javascript-plain colored" style="font-size: 1.5rem;"></i>'
                id="editJS"
              />
              <label class="form-check-label" for="editJS">JavaScript</label>
            </div>

            <div class="form-check form-check-inline">
              <input
                class="form-check-input edit-tech-checkbox"
                type="checkbox"
                value='<i class="devicon-typescript-plain colored" style="font-size: 1.5rem;"></i>'
                id="editTS"
              />
              <label class="form-check-label" for="editTS">TypeScript</label>
            </div>
          </div>

          <div class="form-group pb-2">
            <label for="editUploadImage">Upload Image</label>
            <input type="file" class="form-control" id="editUploadImage" />
            <img
              id="editImagePreview"
              class="img-fluid rounded mt-2 d-none"
              alt="Preview"
              style="max-height: 200px; object-fit: cover;"
            />
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-primary" id="saveChangesBtn">
            Save changes
          </button>
        </div>
      </div>
    </div>
  </div>

  <div
    class="modal fade"
    id="confirmUpdateModal"
    tabindex="-1"
    aria-labelledby="confirmUpdateModalLabel"
    aria-hidden="true"
  >
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="confirmUpdateModalLabel">Confirmation</h5>
          <button
            type="button"
            class="btn-close"
            data-bs-dismiss="modal"
            aria-label="Close"
          ></button>
        </div>
        <div class="modal-body text-center">
          Are you sure you want to update this project?
        </div>
        <div class="modal-footer justify-content-center">
          <button type="button" class="btn btn-secondary" id="confirmNoBtn">
            No
          </button>
          <button type="button" class="btn btn-primary" id="confirmYesBtn">
            Yes
          </button>
        </div>
      </div>
    </div>
  </div>

  <div
    class="modal fade"
    id="confirmDeleteModal"
    tabindex="-1"
    aria-labelledby="confirmDeleteModalLabel"
    aria-hidden="true"
  >
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="confirmDeleteModalLabel">Confirmation</h5>
          <button
            type="button"
            class="btn-close"
            data-bs-dismiss="modal"
            aria-label="Close"
          ></button>
        </div>
        <div class="modal-body text-center">
          Are you sure you want to delete this project?
        </div>
        <div class="modal-footer justify-content-center">
          <button type="button" class="btn btn-secondary" id="confirmDeleteNoBtn">
            No
          </button>
          <button type="button" class="btn btn-danger" id="confirmDeleteYesBtn">
            Yes
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script type="module" src="js/pages/my-projects.js"></script>

