<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{title}}</title>

    <link rel="shortcut icon" href="https://ik.imagekit.io/udenbaguse/logo.gif" type="image/x-icon">

    {{!--! Font Awesome  --}}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    {{!--! Google Fonts --}}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    {{!--! Bootstrap --}}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    {{!--! Devicon --}}
    <link rel="stylesheet" type='text/css' href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css" />
          
    {{!--! Custom CSS --}}
    <link rel="stylesheet" href="/css/style.css" />
    
  </head>

  <body data-bs-theme="dark">
    {{> navbar}}

    <div id="alertBox" class="alert d-none text-center" role="alert"></div>
    {{#if flash}}
      <div class="container mt-3">
        <div class="alert alert-{{flash.type}} text-center" role="alert">
          {{flash.message}}
        </div>
      </div>
    {{/if}}

    {{{body}}}

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
