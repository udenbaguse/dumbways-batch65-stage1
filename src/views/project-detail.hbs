<div class="container mt-4">
  <div class="card bg-dark text-light">
    <img
      src="{{project.image}}"
      class="card-img-top"
      style="height:300px; object-fit:cover;"
    />
    <div class="card-body">
      <h3 class="card-title">{{project.name}}</h3>
      <p class="small text-muted">{{formatDate project.startDate}}
        -
        {{formatDate project.endDate}}</p>
      <p>{{project.description}}</p>
      <p class="small">Technologies: {{{join project.technologies}}}</p>
      <a href="/projects" class="btn btn-secondary">Back</a>
    </div>
  </div>
</div>